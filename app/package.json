    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@azure/msal-angular": "^4.1.1",
    "@azure/msal-browser": "^4.30.0",
    "@microsoft/signalr": "^10.0.11",
    "@primeuix/themes": "^2.0.3",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "material-symbols": "^0.45.10",
