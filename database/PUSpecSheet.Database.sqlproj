<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>PUSpecSheet.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <!--
    legacy\ holds the legacy schema's table scripts, which belong to this project, beside the legacy project and its
    script for moving the tables by hand, which don't.
  -->
  <ItemGroup>
    <Build Remove="legacy\**" />
    <None Remove="legacy\**" />
    <Build Include="legacy\Tables\*.sql" />
  </ItemGroup>
  <!-- Filtered indexes and indexed computed columns need these on, whatever the database's own settings are. -->
  <ItemGroup>
    <Build Update="**\*.sql">
      <AnsiNulls>On</AnsiNulls>
      <QuotedIdentifier>On</QuotedIdentifier>
    </Build>
  </ItemGroup>
  <!--
    The sheet copies' tables moved from dbo, values, references and workflow to legacy. The log tells SqlPackage they
    moved, so a deployment transfers them, rows and all, instead of creating empty tables beside them.
  -->
  <ItemGroup>
    <RefactorLog Include="PUSpecSheet.Database.refactorlog" />
  </ItemGroup>
  <!-- The scripts that run SqlPackage aren't part of the schema, and nor is the seed data. -->
  <ItemGroup>
    <None Include="*.ps1" />
    <Build Remove="seed.sql" />
    <None Include="seed.sql" />
    <Build Remove="seed-local-users.sql" />
    <None Include="seed-local-users.sql" />
  </ItemGroup>
</Project>
