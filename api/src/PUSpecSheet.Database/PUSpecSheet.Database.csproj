<Project Sdk="Microsoft.NET.Sdk">
  <!-- The EF Core side of the database: the DbContext, the Db* entities and their mappings. The schema itself is owned by
       the SQL database project in database/ (database first), so there are no migrations here. -->
  <ItemGroup>
    <ProjectReference Include="..\PUSpecSheet.Domain\PUSpecSheet.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- SqlClient brings in 9.0.x, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7)
         and fails restore; 10.0.13 is the first fixed version. Remove once SqlClient asks for a fixed one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- The legacy migration reads and writes cell settings JSON the same way the converter does (CellJson). -->
    <InternalsVisibleTo Include="PUSpecSheet.Migrator" />
  </ItemGroup>
</Project>
