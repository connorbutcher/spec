<Project>
  <Import Project="Version.props" />

  <PropertyGroup>
    <Company>Red Bull Advanced Services</Company>
    <Authors>IT Software Development</Authors>
    <Copyright>Copyright (c) $(Company)</Copyright>
    <PackageIconUrl></PackageIconUrl>
  </PropertyGroup>

  <!-- Support for building local nugets with valid versions -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Version></Version>
    <VersionPrefix>$(FileVersion)</VersionPrefix>
    <VersionSuffix>alpha.$([System.DateTime]::Now.ToString("yyMMddHHmm"))</VersionSuffix>
    <PackageOutputPath>C:\dev\local_nuget</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
